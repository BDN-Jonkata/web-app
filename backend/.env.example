DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jev_router?schema=public"
PORT=3001

# Temporary AI: create a key at https://console.groq.com/keys (Free plan).
# Server-only. Never use a VITE_ prefix for an API key.
# AI_PROVIDER=agent sends the chat to the team's own agent (BDN-Agent: python -m sim.server)
# at AGENT_URL instead; no Groq key is needed then. Each message is a paid run on the agent's side.
# AGENT_URL=http://127.0.0.1:8600
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173

# Required for signup/login/recovery codes. Use an SMTP provider or a local mail catcher.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Enable ONLY for a local development mail catcher without TLS, never production SMTP.
SMTP_ALLOW_INSECURE=false

# Optional approximate IP location in password-change alerts.
# Opt-in: the request IP is shared with IPinfo. Lite returns country; lookup requires a city-capable plan.
IPINFO_TOKEN=
IPINFO_PLAN=lite
# Set only to exact addresses/CIDR ranges of your reverse proxy. Leave empty for local development.
TRUST_PROXY=

# Optional: when set, POST /api/simulation/decision and /reset require this value in the X-Api-Key header.
SIMULATION_API_KEY=
